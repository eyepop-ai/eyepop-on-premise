EYEPOP_URL=https://compute.eyepop.ai
EYEPOP_API_KEY=
EYEPOP_ACCOUNT_UUID=

# Optional local API port and runtime image override.
# EYEPOP_HTTP_PORT=8080
# EYEPOP_RUNTIME_IMAGE=registry.eyepop.ai/ai/runtime-cpu:latest

# Intel OpenVINO accelerator access. Get the value with:
# getent group render | cut -d: -f3
# RENDER_GROUP_ID=
# OPENVINO_DEVICE_TYPE=AUTO

# Qualcomm QNN host integration. The defaults below match the validated
# Innodisk EXEC-Q911 layout; group IDs are host-specific.
# QAIRT_SDK_ROOT=/opt/qcom/aistack/qairt/2.41.0.251128
# FASTRPC_GROUP_ID=
# DMAHEAP_GROUP_ID=

# Optional Tailscale helper settings for private camera-network access.
# TS_AUTHKEY=tskey-auth-xxxxx
# TS_HOSTNAME=eyepop-agent
